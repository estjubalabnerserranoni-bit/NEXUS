using System;
using System.Drawing;
using System.IO;
using System.Text.Json;
using System.Windows.Forms;

namespace NexusJuegoForms;

internal static class Program
{
    [STAThread]
    static void Main()
    {
        Application.EnableVisualStyles();
        Application.SetCompatibleTextRenderingDefault(false);
        Application.Run(new VentanaNexus());
    }
}

// El explorador controla los recursos del jugador.
public class Explorador
{
    public string Nombre { get; set; } = "";
    public string RealidadActual { get; set; } = "Alfa";
    public int Energia { get; set; } = 100;
    public int Estabilidad { get; set; } = 100;
    public int NivelAcceso { get; set; } = 1;
    public bool NucleoInestable { get; set; }

    public bool GastarEnergia(int costo)
    {
        if (Energia < costo) return false;
        Energia -= costo;
        return true;
    }

    public void Recargar()
    {
        Energia = Math.Min(100, Energia + 30);
        Estabilidad = Math.Min(100, Estabilidad + 10);
    }
}

// La misión recuerda los hallazgos y entrega la recompensa una sola vez.
public class Mision
{
    public string Codigo { get; set; } = "MIS-001";
    public bool TieneRecurso { get; set; }
    public bool TieneAnalisis { get; set; }
    public bool Completada { get; set; }

    public bool Entregar(Explorador cadete)
    {
        if (Completada || !TieneRecurso || !TieneAnalisis) return false;
        Completada = true;
        cadete.NivelAcceso++;
        return true;
    }
}

public class Partida
{
    public Explorador Cadete { get; set; } = new();
    public Mision Mision { get; set; } = new();
    public int Posicion { get; set; }
    public bool[] Investigados { get; set; } = new bool[9];
}

public class VentanaNexus : Form
{
    readonly Color fondo = Color.FromArgb(16, 26, 43);
    readonly Color panel = Color.FromArgb(32, 50, 74);
    readonly Color turquesa = Color.FromArgb(36, 106, 111);
    readonly string archivo = Path.Combine(Application.LocalUserAppDataPath, "partida.json");
    readonly string[] alfa = { "Base", "Vacío", "Vacío", "Vacío", "Recurso", "Vacío", "Vacío", "Anomalía", "Vacío" };
    readonly string[] beta = { "Base", "Anomalía", "Vacío", "Vacío", "Vacío", "Recurso", "Anomalía", "Vacío", "Anomalía" };

    readonly TextBox nombre = new();
    readonly ComboBox realidad = new();
    readonly NumericUpDown frecuencia = new();
    readonly Button[] sectores = new Button[9];
    readonly Panel juego = new();
    readonly Label estado = new(), objetivos = new(), iris = new();
    Partida partida = new();

    Explorador Cadete => partida.Cadete;
    Mision MisionActual => partida.Mision;
    string[] Mapa => Cadete.RealidadActual == "Beta" ? beta : alfa;

    public VentanaNexus()
    {
        Text = "NEXUS | Exploración de realidades";
        ClientSize = new Size(890, 600);
        FormBorderStyle = FormBorderStyle.FixedSingle;
        MaximizeBox = false;
        StartPosition = FormStartPosition.CenterScreen;
        Font = new Font("Segoe UI", 10);
        BackColor = fondo;
        ForeColor = Color.White;

        Rotulo(this, "NEXUS", 22, 8, 200, 42, 25);
        Rotulo(this, "Año 2297   /   Centro de exploración", 230, 12, 570, 35);
        Rotulo(this, "Cadete", 24, 55, 145, 25);
        Rotulo(this, "Realidad", 235, 55, 120, 25);
        Poner(this, nombre, 24, 82, 190, 28);
        nombre.MaxLength = 35;
        realidad.DropDownStyle = ComboBoxStyle.DropDownList;
        realidad.Items.AddRange(new object[] { "Alfa", "Beta" });
        realidad.SelectedIndex = 0;
        Poner(this, realidad, 235, 82, 120, 28);
        Boton(this, "Nueva partida", 375, 76, 145, 38, NuevaPartida);
        Boton(this, "Continuar guardada", 535, 76, 175, 38, Cargar);

        Poner(this, juego, 0, 125, 890, 400);
        Rotulo(juego, "Mapa de sectores", 24, 5, 345, 35, 16);
        Rotulo(juego, "Elige una casilla para viajar. Cada viaje cuesta 10.", 24, 45, 400, 32);
        for (int i = 0; i < sectores.Length; i++)
        {
            int sector = i;
            int x = 24 + (i % 3) * 130;
            int y = 86 + (i / 3) * 73;
            sectores[i] = Boton(juego, "", x, y, 122, 64, () => Viajar(sector));
        }

        Rotulo(juego, "Estado del explorador", 435, 5, 420, 35, 16);
        Poner(juego, estado, 437, 48, 435, 63);
        Poner(juego, objetivos, 437, 115, 435, 82);
        Rotulo(juego, "Frecuencia del escáner (1–100)", 435, 200, 350, 28);
        frecuencia.Minimum = 1;
        frecuencia.Maximum = 100;
        frecuencia.Value = 60;
        Poner(juego, frecuencia, 437, 235, 85, 30);
        Boton(juego, "Escanear sector", 535, 229, 155, 38, Escanear);
        Boton(juego, "Recargar", 437, 282, 115, 38, Recargar);
        Boton(juego, "Purgar núcleo", 562, 282, 135, 38, Purgar);
        Boton(juego, "Guardar partida", 707, 282, 145, 38, Guardar);

        iris.BackColor = panel;
        iris.Padding = new Padding(12);
        Poner(this, iris, 24, 518, 828, 66);
        juego.Enabled = false;
        Aviso("Escribe tu nombre y elige una realidad, o continúa una partida guardada.");
    }

    void Poner(Control padre, Control control, int x, int y, int ancho, int alto)
    {
        control.SetBounds(x, y, ancho, alto);
        padre.Controls.Add(control);
    }

    void Rotulo(Control padre, string texto, int x, int y, int ancho, int alto, int tamano = 10)
    {
        Label etiqueta = new() { Text = texto, Font = new Font("Segoe UI", tamano),
            TextAlign = ContentAlignment.MiddleLeft };
        Poner(padre, etiqueta, x, y, ancho, alto);
    }

    Button Boton(Control padre, string texto, int x, int y, int ancho, int alto, Action accion)
    {
        Button boton = new() { Text = texto, BackColor = panel, ForeColor = Color.White,
            FlatStyle = FlatStyle.Flat, Cursor = Cursors.Hand };
        boton.Click += (s, e) => accion();
        Poner(padre, boton, x, y, ancho, alto);
        return boton;
    }

    void Aviso(string mensaje) => iris.Text = "IRIS   |   " + mensaje;

    void NuevaPartida()
    {
        if (nombre.Text.Trim() == "") { Aviso("Ingresa el nombre del cadete."); return; }
        if (juego.Enabled && MessageBox.Show("¿Empezar otra partida?", "NEXUS",
            MessageBoxButtons.YesNo) != DialogResult.Yes) return;
        partida = new Partida();
        Cadete.Nombre = nombre.Text.Trim();
        Cadete.RealidadActual = realidad.Text;
        juego.Enabled = true;
        Actualizar();
        Aviso("MIS-001 iniciada. Recupera un recurso, analiza una anomalía y regresa a la base.");
    }

    void Viajar(int destino)
    {
        if (partida.Posicion == destino) { Aviso("Ya estás en ese sector."); return; }
        if (!Cadete.GastarEnergia(10)) { Aviso("Necesitas 10 de energía. Usa Recargar."); return; }
        partida.Posicion = destino;
        string tipo = Mapa[destino];
        if (tipo == "Base")
        {
            if (MisionActual.Entregar(Cadete)) Aviso("¡Misión completada! Obtuviste acceso de nivel 2.");
            else Aviso(MisionActual.Completada ? "Misión ya entregada." : "Estás en la base. Revisa tus objetivos.");
        }
        else if (partida.Investigados[destino]) Aviso("Ya investigaste este sector.");
        else if (tipo == "Recurso")
        {
            partida.Investigados[destino] = true;
            MisionActual.TieneRecurso = true;
            Aviso("Recurso recuperado y añadido al equipo de la misión.");
        }
        else if (tipo == "Anomalía") Aviso("Anomalía localizada. Elige una frecuencia y pulsa Escanear sector.");
        else Aviso("Sector vacío. No se encontraron hallazgos.");
        Actualizar();
    }

    void Escanear()
    {
        int posicion = partida.Posicion;
        if (Mapa[posicion] != "Anomalía") { Aviso("Viaja primero a una casilla con anomalía."); return; }
        if (partida.Investigados[posicion]) { Aviso("Esta anomalía ya fue analizada."); return; }
        if (frecuencia.Value < 40) { Aviso("Señal débil. Prueba otra frecuencia. Consumo: 0."); return; }
        bool critica = frecuencia.Value > 80;
        int costo = critica ? 20 : 5;
        if (!Cadete.GastarEnergia(costo)) { Aviso($"Necesitas {costo} de energía para este escaneo."); return; }
        if (critica)
        {
            Cadete.Estabilidad = Math.Max(0, Cadete.Estabilidad - 20);
            Cadete.NucleoInestable = true;
        }
        partida.Investigados[posicion] = true;
        MisionActual.TieneAnalisis = true;
        Aviso(critica ? "Anomalía crítica registrada. Energía -20 y estabilidad -20. Puedes purgar el núcleo."
                      : "Anomalía estable registrada. Energía -5.");
        Actualizar();
    }

    void Recargar()
    {
        Cadete.Recargar();
        Actualizar();
        Aviso("Recarga realizada. Energía y estabilidad actualizadas.");
    }

    void Purgar()
    {
        if (!Cadete.NucleoInestable) { Aviso("El núcleo ya está estable."); return; }
        Cadete.NucleoInestable = false;
        Actualizar();
        Aviso("Purga completada. El núcleo vuelve a funcionar con normalidad.");
    }

    void Actualizar()
    {
        estado.Text = $"{Cadete.Nombre}  |  Realidad {Cadete.RealidadActual}  |  Nivel {Cadete.NivelAcceso}\n" +
            $"Energía: {Cadete.Energia}%     Estabilidad: {Cadete.Estabilidad}%\n" +
            $"Núcleo: {(Cadete.NucleoInestable ? "Inestable" : "Normal")}";
        objetivos.Text = $"{MisionActual.Codigo}  |  {(MisionActual.Completada ? "Completada" : "En curso")}\n" +
            $"Recurso: {(MisionActual.TieneRecurso ? "Recuperado" : "Pendiente")}\n" +
            $"Anomalía: {(MisionActual.TieneAnalisis ? "Analizada" : "Pendiente")}\nEntrega: volver a la base";
        for (int i = 0; i < sectores.Length; i++)
        {
            bool actual = partida.Posicion == i;
            string marca = partida.Investigados[i] ? " · Listo" : "";
            sectores[i].Text = $"{i / 3 + 1},{i % 3 + 1}   {Mapa[i]}\n{(actual ? "Aquí" : "")}{marca}";
            sectores[i].BackColor = actual ? turquesa : panel;
        }
    }

    void Guardar()
    {
        try
        {
            File.WriteAllText(archivo + ".tmp", JsonSerializer.Serialize(partida));
            File.Move(archivo + ".tmp", archivo, true);
            Aviso("Partida guardada. Puedes cerrar y usar Continuar guardada al regresar.");
        }
        catch (Exception error) { Aviso("No se pudo guardar. " + error.Message); }
    }

    void Cargar()
    {
        if (!File.Exists(archivo)) { Aviso("Todavía no hay una partida guardada."); return; }
        try
        {
            var guardada = JsonSerializer.Deserialize<Partida>(File.ReadAllText(archivo));
            if (guardada?.Cadete == null || guardada.Mision == null || guardada.Investigados?.Length != 9 ||
                guardada.Posicion < 0 || guardada.Posicion > 8)
                throw new InvalidDataException("El archivo de la partida está incompleto.");
            partida = guardada;
            nombre.Text = Cadete.Nombre;
            realidad.SelectedItem = Cadete.RealidadActual;
            juego.Enabled = true;
            Actualizar();
            Aviso("Partida recuperada. Continúa desde el sector marcado.");
        }
        catch (Exception error) { Aviso("No se pudo cargar. " + error.Message); }
    }
}
