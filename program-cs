using System;
using System.IO;

namespace NEXUS_v1;

class Explorador
{
    public string Nombre { get; }
    public int Edad { get; }
    public string RealidadActual { get; }
    public int Energia { get; private set; } = 100;
    public int Estabilidad { get; private set; } = 100;
    public int NivelAcceso { get; private set; } = 1;
    public bool NucleoInestable { get; private set; }

    public Explorador(string nombre, int edad, string realidad)
    {
        Nombre = nombre;
        Edad = edad;
        RealidadActual = realidad;
    }

    public bool GastarEnergia(int costo)
    {
        if (Energia < costo)
        {
            Console.WriteLine($"IRIS: necesitas {costo} de energía y tienes {Energia}.");
            return false;
        }

        Energia -= costo;
        return true;
    }

    public void DetectarAnomaliaCritica()
    {
        Estabilidad = Math.Max(0, Estabilidad - 20);
        NucleoInestable = true;
    }

    public void RecargarEnergia()
    {
        Energia = Math.Min(100, Energia + 30);
        Estabilidad = Math.Min(100, Estabilidad + 10);
        Console.WriteLine($"Recarga finalizada. Energía: {Energia}% | Estabilidad: {Estabilidad}%");
    }

    public void PurgarNucleo()
    {
        NucleoInestable = false;
        Console.WriteLine("IRIS: núcleo estabilizado.");
    }

    public void RevisarEmergencia()
    {
        if (Energia < 20 && Estabilidad < 20 && NucleoInestable)
        {
            Energia = 50;
            Estabilidad = 50;
            NucleoInestable = false;
            Console.WriteLine("IRIS: purga de emergencia. Energía y estabilidad recuperadas al 50%.");
        }
        else if (Energia < 20 || Estabilidad < 20)
        {
            Console.WriteLine("IRIS: recursos bajos. Revisa tu estado antes de continuar.");
        }
    }

    public void SubirNivel() => NivelAcceso++;

    public void MostrarEstado()
    {
        Console.WriteLine($"\nCadete: {Nombre} | Edad: {Edad} | Acceso: nivel {NivelAcceso}");
        Console.WriteLine($"Destino: {RealidadActual}");
        Console.WriteLine($"Energía: {Energia}% | Estabilidad: {Estabilidad}%");
        Console.WriteLine("Núcleo: " + (NucleoInestable ? "Inestable" : "Normal"));
    }
}

class Mision
{
    public string CodigoMision { get; } = "MIS-001";
    public string Descripcion { get; } = "Recuperar un recurso, analizar una anomalía y volver a la base.";
    public string Estado { get; private set; } = "Pendiente";
    public bool RecursoRecuperado { get; private set; }
    public bool AnomaliaAnalizada { get; private set; }

    public void IniciarMision()
    {
        Estado = "En curso";
        Console.WriteLine($"\n{CodigoMision} | {Descripcion}");
    }

    public void RegistrarRecurso() => RecursoRecuperado = true;
    public void RegistrarAnalisis() => AnomaliaAnalizada = true;

    public void MostrarObjetivos()
    {
        Console.WriteLine($"\n{CodigoMision} | Estado: {Estado}");
        Console.WriteLine($"[{(RecursoRecuperado ? "X" : " ")}] Recuperar un recurso.");
        Console.WriteLine($"[{(AnomaliaAnalizada ? "X" : " ")}] Analizar una anomalía.");
        Console.WriteLine($"[{(Estado == "Completada" ? "X" : " ")}] Entregar los hallazgos en la base.");
    }

    public void CompletarMision(Explorador cadete)
    {
        if (Estado == "Completada")
        {
            Console.WriteLine("Esta misión ya fue entregada.");
            return;
        }

        if (!RecursoRecuperado || !AnomaliaAnalizada)
        {
            Console.WriteLine("IRIS: todavía quedan objetivos pendientes.");
            MostrarObjetivos();
            return;
        }

        Estado = "Completada";
        cadete.SubirNivel();
        Console.WriteLine($"MISIÓN COMPLETADA. {cadete.Nombre} obtiene acceso de nivel {cadete.NivelAcceso}.");
    }
}

class Program
{
    // B = base, A = anomalía, R = recurso, . = sector vacío.
    static readonly char[,] alfa =
    {
        { 'B', '.', '.' },
        { '.', 'R', '.' },
        { '.', 'A', '.' }
    };

    static readonly char[,] beta =
    {
        { 'B', 'A', '.' },
        { '.', '.', 'R' },
        { 'A', '.', 'A' }
    };

    static void Main()
    {
        try { Jugar(); }
        catch (EndOfStreamException) { Console.WriteLine("\nTransmisión finalizada."); }
    }

    static void Jugar()
    {
        Console.WriteLine("========== NEXUS | AÑO 2297 ==========");
        string nombre;
        do
        {
            Console.Write("Nombre del cadete: ");
            nombre = LeerTexto();
        } while (nombre.Length == 0);

        int edad = LeerNumero("Edad", 1, 120);
        Console.WriteLine("1. Realidad Alfa     2. Realidad Beta");
        int destino = LeerNumero("Elige una realidad", 1, 2);

        Explorador cadete = new Explorador(nombre, edad, destino == 1 ? "Alfa" : "Beta");
        char[,] mapa = (char[,])(destino == 1 ? alfa : beta).Clone();
        int fila = 0, columna = 0;
        Mision mision = new Mision();
        mision.IniciarMision();

        while (true)
        {
            Console.WriteLine($"\n--- NEXUS | {cadete.Nombre} | Energía: {cadete.Energia}% ---");
            Console.WriteLine("1. Ver mapa y explorar");
            Console.WriteLine("2. Escanear anomalía del sector actual");
            Console.WriteLine("3. Consultar estado y misión");
            Console.WriteLine("4. Recargar energía");
            Console.WriteLine("5. Terminal IRIS");
            Console.WriteLine("6. Salir");

            switch (LeerNumero("Opción", 1, 6))
            {
                case 1:
                    Explorar(mapa, cadete, mision, ref fila, ref columna);
                    break;
                case 2:
                    Escanear(mapa, cadete, mision, fila, columna);
                    break;
                case 3:
                    cadete.MostrarEstado();
                    mision.MostrarObjetivos();
                    break;
                case 4:
                    cadete.RecargarEnergia();
                    break;
                case 5:
                    TerminalIRIS(cadete, mision);
                    break;
                case 6:
                    Console.WriteLine($"Desconexión segura. Hasta pronto, {cadete.Nombre}.");
                    return;
            }
            cadete.RevisarEmergencia();
        }
    }

    static void Explorar(char[,] mapa, Explorador cadete, Mision mision,
                         ref int fila, ref int columna)
    {
        Console.WriteLine($"\nMapa de la realidad {cadete.RealidadActual}");
        Console.WriteLine("B: base | R: recurso | A: anomalía | .: vacío | X: explorado");
        Console.WriteLine("Los corchetes indican tu posición.\n      1  2  3");

        for (int f = 0; f < 3; f++)
        {
            Console.Write($"  {f + 1}  ");
            for (int c = 0; c < 3; c++)
            {
                char sector = mapa[f, c];
                Console.Write(f == fila && c == columna ? $"[{sector}]" : $" {sector} ");
            }
            Console.WriteLine();
        }

        int nuevaFila = LeerNumero("Fila de destino (0 para volver)", 0, 3);
        if (nuevaFila == 0) return;
        nuevaFila--;
        int nuevaColumna = LeerNumero("Columna de destino", 1, 3) - 1;

        if (nuevaFila == fila && nuevaColumna == columna)
        {
            Console.WriteLine("Ya estás en ese sector.");
            return;
        }
        if (!cadete.GastarEnergia(10)) return;

        fila = nuevaFila;
        columna = nuevaColumna;
        switch (mapa[fila, columna])
        {
            case 'B':
                Console.WriteLine("Llegaste a la base.");
                mision.CompletarMision(cadete);
                break;
            case 'R':
                mision.RegistrarRecurso();
                mapa[fila, columna] = 'X';
                Console.WriteLine("Recurso recuperado y registrado en la misión.");
                break;
            case 'A':
                Console.WriteLine("Anomalía localizada. Usa la opción 2 para escanearla.");
                break;
            case 'X':
                Console.WriteLine("Este sector ya fue investigado.");
                break;
            default:
                Console.WriteLine("Sector vacío. No se encontraron hallazgos.");
                break;
        }
    }

    static void Escanear(char[,] mapa, Explorador cadete, Mision mision, int fila, int columna)
    {
        if (mapa[fila, columna] != 'A')
        {
            Console.WriteLine("No hay una anomalía pendiente aquí. Busca una A en el mapa.");
            return;
        }

        int frecuencia = LeerNumero("Frecuencia del escáner", 1, 100);
        if (frecuencia < 40)
        {
            Console.WriteLine("Señal débil. Prueba otra frecuencia. Energía consumida: 0.");
            return;
        }

        bool critica = frecuencia > 80;
        int costo = critica ? 20 : 5;
        if (!cadete.GastarEnergia(costo)) return;

        if (critica) cadete.DetectarAnomaliaCritica();
        mision.RegistrarAnalisis();
        mapa[fila, columna] = 'X';
        Console.WriteLine(critica
            ? "Anomalía crítica registrada. Energía -20, estabilidad -20."
            : "Anomalía estable registrada. Energía -5.");
    }

    static void TerminalIRIS(Explorador cadete, Mision mision)
    {
        Console.WriteLine("\nIRIS | 1. Diagnóstico   2. Purgar núcleo   3. Volver");
        int opcion = LeerNumero("Comando", 1, 3);
        if (opcion == 1)
        {
            cadete.MostrarEstado();
            mision.MostrarObjetivos();
        }
        else if (opcion == 2)
        {
            cadete.PurgarNucleo();
        }
    }

    static string LeerTexto() =>
        Console.ReadLine()?.Trim() ?? throw new EndOfStreamException();

    static int LeerNumero(string mensaje, int minimo, int maximo)
    {
        while (true)
        {
            Console.Write($"{mensaje} [{minimo}-{maximo}]: ");
            if (int.TryParse(LeerTexto(), out int numero) && numero >= minimo && numero <= maximo)
                return numero;
            Console.WriteLine("Entrada inválida. Escribe un número dentro del rango.");
        }
    }
}
