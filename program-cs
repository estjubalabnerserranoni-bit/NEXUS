using System;
using System.Threading;

namespace NEXUS_v1
{
    class Program
    {
        static string nombreCadete = "Sin Registrar";
        static int edadCadete = 0;
        static string realidadAsignada = "Ninguna";

        static int energia = 100;
        static int estabilidadConexion = 100;
        static bool sistemaInestable = false;
        static bool sesionActiva = true;

        static string[] moduloEntrenamiento = { "Escaneo", "Estabilizador", "Extractor", "Sobrecarga" };

        static int[,] mapaRealidadAlfa = {
            { 1, 0, 0 },
            { 0, 3, 0 },
            { 0, 2, 0 }
        };

        static int[,] mapaRealidadBeta = {
            { 1, 2, 0 },
            { 0, 0, 3 },
            { 2, 0, 2 }
        };

        static void Main(string[] args)
        {
            Console.Clear();
            MostrarEncabezado("SISTEMA CENTRAL NEXUS v1.0");

            RegistrarCadete();

            if (energia >= 50 && estabilidadConexion >= 50)
            {
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("\n[INMERSIÓN AUTORIZADA] Conexión estable con NEXUS.");
                Console.ResetColor();
                Thread.Sleep(1500);

                while (sesionActiva)
                {
                    VerificarSituacionCriticaIRIS();

                    MostrarMenuPrincipal();
                    string opcion = Console.ReadLine();
                    ProcesarOpcionMenu(opcion);
                }
            }
            else
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("\n[INMERSIÓN RECHAZADA] Parámetros insuficientes.");
                Console.ResetColor();
            }

            MostrarEncabezado("CERRANDO TRANSMISIÓN NEXUS v1.0");
        }

        static void RegistrarCadete()
        {
            Console.ForegroundColor = ConsoleColor.Yellow;
            Console.WriteLine("--- PROTOCOLO DE REGISTRO ---");
            Console.ResetColor();

            Console.Write("Ingrese Nombre del Cadete: ");
            nombreCadete = Console.ReadLine();

            Console.Write("Ingrese Edad del Cadete: ");
            if (!int.TryParse(Console.ReadLine(), out edadCadete))
            {
                edadCadete = 18; 
            }

            Console.WriteLine("\nSeleccione Realidad Asignada:");
            Console.WriteLine("1. Realidad Alfa (Bajo peligro)");
            Console.WriteLine("2. Realidad Beta (Anomalías elevadas)");
            Console.Write("Opción: ");
            string eleccion = Console.ReadLine();

            if (eleccion == "2")
            {
                realidadAsignada = "Realidad Beta";
            }
            else
            {
                realidadAsignada = "Realidad Alfa";
            }

            Console.WriteLine($"\nCadete {nombreCadete} registrado con éxito en {realidadAsignada}.");
        }

        static void ConsultarEstado()
        {
            MostrarEncabezado("ESTADO GENERAL DEL SISTEMA");
            Console.WriteLine($"Cadete: {nombreCadete} | Edad: {edadCadete}");
            Console.WriteLine($"Realidad Actual: {realidadAsignada}");

            Console.Write("Energía: [");
            int barras = energia / 10;
            Console.ForegroundColor = ConsoleColor.Cyan;
            for (int i = 0; i < 10; i++)
            {
                if (i < barras) Console.Write("█");
                else Console.Write("░");
            }
            Console.ResetColor();
            Console.WriteLine($"] {energia}%");

            Console.WriteLine($"Estabilidad de Conexión: {estabilidadConexion}%");
            Console.WriteLine($"Estado de Núcleo: {(sistemaInestable ? "INESTABLE" : "NORMAL")}");

            Console.WriteLine("\nMódulos de Equipamiento disponibles:");
            for (int i = 0; i < moduloEntrenamiento.Length; i++)
            {
                Console.WriteLine($" - [{i + 1}] {moduloEntrenamiento[i]}");
            }

            Pausar();
        }

        static void RecuperarEnergia()
        {
            MostrarEncabezado("RECARGA DE ENERGÍA DE NÚCLEO");
            if (energia < 100)
            {
                energia += 30;
                if (energia > 100) energia = 100;

                estabilidadConexion += 10;
                if (estabilidadConexion > 100) estabilidadConexion = 100;

                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("Energía y conexión recargadas con éxito.");
            }
            else
            {
                Console.WriteLine("La energía ya se encuentra al máximo.");
            }
            Console.ResetColor();
            Pausar();
        }

        static void AnalizarAnomalia()
        {
            MostrarEncabezado("ANÁLISIS DE ANOMALÍAS DE REALIDAD");

            Console.Write("Seleccione el nivel de frecuencia a escanear (1-100): ");
            int.TryParse(Console.ReadLine(), out int frecuencia);

            Console.Write("Escaneando");
            for (int i = 0; i < 3; i++)
            {
                Thread.Sleep(300);
                Console.Write(".");
            }
            Console.WriteLine();

            if (frecuencia > 80)
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("-> RESULTADO: Anomalía Crítica Detectada. Absorción de energía inminente.");
                energia -= 20;
                sistemaInestable = true;
            }
            else if (frecuencia >= 40 && frecuencia <= 80)
            {
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine("-> RESULTADO: Anomalía Estable. Datos procesados sin pérdidas.");
                energia -= 5;
            }
            else
            {
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("-> RESULTADO: Señal Débil. No se registraron alteraciones.");
            }
            Console.ResetColor();
            Pausar();
        }

        static void VerificarSituacionCriticaIRIS()
        {
            if (energia < 20 || estabilidadConexion < 20)
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("\n==================================================");
                Console.WriteLine(" [ALERTA DE SEGURIDAD IRIS] ");
                Console.WriteLine(" Crítico: Nivel de recursos bajo mínimas de seguridad.");
                Console.WriteLine("==================================================");
                Console.ResetColor();

                if (energia < 20 && estabilidadConexion < 20 && sistemaInestable)
                {
                    Console.ForegroundColor = ConsoleColor.Magenta;
                    Console.WriteLine("[NIVEL ÉLITE] IRIS ejecuta purga de emergencia.");
                    energia = 50;
                    estabilidadConexion = 50;
                    sistemaInestable = false;
                    Console.WriteLine("-> Estado estabilizado forzosamente.");
                    Console.ResetColor();
                }
            }
        }

        static void ComunicacionIRIS()
        {
            MostrarEncabezado("CONSOLA DE COMUNICACIÓN IRIS");
            Console.WriteLine("IRIS: 'Cadete, estoy monitoreando la estructura de la realidad.'");
            Console.WriteLine("Opciones de interacción:");
            Console.WriteLine("1. Solicitar diagnóstico");
            Console.WriteLine("2. Forzar purga de errores");
            Console.Write("Selección: ");
            string resp = Console.ReadLine();

            if (resp == "1")
            {
                Console.WriteLine($"IRIS: 'Energía al {energia}%. Recomendación: Mantener estabilidad.'");
            }
            else if (resp == "2")
            {
                sistemaInestable = false;
                Console.WriteLine("IRIS: 'Errores purgados. Sistema inestable desmarcado.'");
            }
            else
            {
                Console.WriteLine("IRIS: 'Comando no reconocido.'");
            }
            Pausar();
        }

        static void ExplorarRealidadMapas()
        {
            MostrarEncabezado("EXPLORACIÓN DE MAPA DE REALIDAD");

            int[,] mapaSeleccionado;
            if (realidadAsignada == "Realidad Beta")
            {
                mapaSeleccionado = mapaRealidadBeta;
            }
            else
            {
                mapaSeleccionado = mapaRealidadAlfa;
            }

            Console.WriteLine($"Renderizando Sector: {realidadAsignada}\n");

            Console.WriteLine("Leyenda: [P] Jugador | [A] Anomalía | [R] Recurso | [.] Vacío\n");

            for (int fila = 0; fila < 3; fila++)
            {
                Console.Write("\t");
                for (int col = 0; col < 3; col++)
                {
                    int celda = mapaSeleccionado[fila, col];

                    switch (celda)
                    {
                        case 1:
                            Console.ForegroundColor = ConsoleColor.Green;
                            Console.Write("[P] ");
                            break;
                        case 2:
                            Console.ForegroundColor = ConsoleColor.Red;
                            Console.Write("[A] ");
                            break;
                        case 3:
                            Console.ForegroundColor = ConsoleColor.Yellow;
                            Console.Write("[R] ");
                            break;
                        default:
                            Console.ForegroundColor = ConsoleColor.Gray;
                            Console.Write("[.] ");
                            break;
                    }
                    Console.ResetColor();
                }
                Console.WriteLine();
            }

            energia -= 10;
            Console.WriteLine("\nExploración completada. Energía consumida: -10%");
            Pausar();
        }

        static void MostrarMenuPrincipal()
        {
            Console.Clear();
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.WriteLine("==================================================");
            Console.WriteLine($"        NEXUS v1.0 | CADETE: {nombreCadete.ToUpper()}");
            Console.WriteLine("==================================================");
            Console.ResetColor();
            Console.WriteLine("1. Explorar Mapa de Realidades (Matriz)");
            Console.WriteLine("2. Analizar Anomalía (Misión 02)");
            Console.WriteLine("3. Consultar Estado y Módulos");
            Console.WriteLine("4. Recargar Energía del Sistema");
            Console.WriteLine("5. Terminal de Comunicación IRIS");
            Console.WriteLine("6. Desconexión Controlada (Salir)");
            Console.Write("\nSeleccione una opción (1-6): ");
        }

        static void ProcesarOpcionMenu(string opcion)
        {
            switch (opcion)
            {
                case "1":
                    ExplorarRealidadMapas();
                    break;
                case "2":
                    AnalizarAnomalia();
                    break;
                case "3":
                    ConsultarEstado();
                    break;
                case "4":
                    RecuperarEnergia();
                    break;
                case "5":
                    ComunicacionIRIS();
                    break;
                case "6":
                    Console.ForegroundColor = ConsoleColor.Yellow;
                    Console.WriteLine("\nIniciando desconexión segura...");
                    sesionActiva = false; 
                    Thread.Sleep(1000);
                    break;
                default:
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine("\nOpción inválida. Intente de nuevo.");
                    Console.ResetColor();
                    Pausar();
                    break;
            }
        }

        static void MostrarEncabezado(string titulo)
        {
            Console.Clear();
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.WriteLine("==================================================");
            Console.WriteLine($"  {titulo}");
            Console.WriteLine("==================================================");
            Console.ResetColor();
            Console.WriteLine();
        }

        static void Pausar()
        {
            Console.ForegroundColor = ConsoleColor.DarkGray;
            Console.WriteLine("\nPresione cualquier tecla para continuar...");
            Console.ResetColor();
            Console.ReadKey();
        }
    }
}
